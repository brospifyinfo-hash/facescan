# Copy to .env.local and fill in. Nothing here is committed.

# ---------------------------------------------------------------------------
# Sign-in email (Resend)
# ---------------------------------------------------------------------------
# Without a key: in development the login code is printed to the server
# console so the flow stays testable; in production /api/auth/request-code
# returns 501 rather than pretending the mail went out.
RESEND_API_KEY=

# Must be a domain verified in Resend. The default sandbox sender only
# delivers to the address that owns the Resend account.
AUTH_FROM_EMAIL="FaceScan <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# 32+ random characters. Required in production — lib/auth/session.ts throws
# rather than mint forgeable session cookies with a known dev secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# AI deep-dive report (Blueprint tier)
# ---------------------------------------------------------------------------
# ⚠️ /api/report does not verify payment yet. With a key set, anyone who
# knows the route can spend your credits. Gate it on a Stripe webhook before
# putting a key here in production.
ANTHROPIC_API_KEY=
