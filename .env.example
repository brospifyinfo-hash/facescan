# Copy to .env.local for local work; set the same names in Vercel for
# production. Nothing here is committed.

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# 32+ random characters. REQUIRED in production — lib/auth/session.ts throws
# rather than mint forgeable session cookies with a known dev secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Sign-in email (Resend)
# ---------------------------------------------------------------------------
# Without a key: in development the login code prints to the server console;
# in production /api/auth/request-code returns 501 rather than pretending the
# mail went out.
RESEND_API_KEY=
# Must be a domain verified in Resend. The sandbox sender below only delivers
# to the address that owns the Resend account.
AUTH_FROM_EMAIL="FaceScan <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Server-side secret. Never exposed to the browser.
STRIPE_SECRET_KEY=

# Browser-side publishable key. NEXT_PUBLIC_ means it ships in the bundle —
# that is correct and expected for this one value.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for THIS endpoint, from the Stripe dashboard webhook you
# create for https://<your-domain>/api/stripe/webhook
#
# ⚠️ The local `stripe listen` secret and the dashboard secret are DIFFERENT
# values. Using the wrong one makes every event fail signature verification
# with a 400, which looks exactly like an attack in the logs.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GPT-4.1 Vision scoring (lib/vision/, /api/vision-scan)
# ---------------------------------------------------------------------------
# Which engine scores the face. "vision" routes the whole rating through
# GPT-4.1; anything else (or unset) keeps the on-device geometry pipeline.
# NEXT_PUBLIC_ because the decision is made in the browser, on /scan.
NEXT_PUBLIC_SCORE_ENGINE=

# Server-side key for the Responses API. Never exposed to the browser.
#
# One key for everything that talks to a model: the vision scoring, the paid
# deep-dive report (/api/report) and the style studio all run on OpenAI.
# There is no ANTHROPIC_API_KEY any more. The money-spending routes are
# gated on requireCapability() in lib/access.ts (session always; the
# entitlement whenever one could exist).
OPENAI_API_KEY=

# Optional overrides. Defaults in brackets.
#   OPENAI_VISION_MODEL        [gpt-4.1]  must support vision + structured outputs
#   VISION_TIMEOUT_MS          [45000]    per attempt; 3 attempts must fit maxDuration 60
#   VISION_MAX_ATTEMPTS        [3]
#   VISION_MAX_OUTPUT_TOKENS   [4000]     too low truncates the JSON and loses the call
#   VISION_RATE_LIMIT          [6]        calls per IP per minute, per warm instance
#   VISION_LOG                 [on]       "off" silences, "debug" adds cache lines
OPENAI_VISION_MODEL=
VISION_TIMEOUT_MS=
VISION_MAX_ATTEMPTS=
VISION_MAX_OUTPUT_TOKENS=
VISION_RATE_LIMIT=
VISION_LOG=

# ---------------------------------------------------------------------------
# Face embedding (stage 5 of the analysis pipeline)
# ---------------------------------------------------------------------------
# URL of an ONNX face-recognition model (ArcFace family). Runs in the
# BROWSER via onnxruntime-web, so photos still never leave the device.
#
#   MobileFaceNet export  ~4 MB   — fast, good enough for stability
#   buffalo_l / w600k     ~90 MB  — stronger, noticeable first-load cost
#
# Unset, stage 5 is a clean no-op and the pipeline runs on geometry alone.
#
# ⚠️ The embedding only feeds CONFIDENCE today. Using it for the score needs
# a regression head trained on labelled ratings — see lib/analysis/embedding.ts
NEXT_PUBLIC_FACE_EMBEDDING_MODEL_URL=
